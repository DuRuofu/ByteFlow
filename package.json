{
  "name": "byteflow",
  "version": "1.0.0",
  "description": "一个基于electron的串口助手软件",
  "license": "ISC",
  "author": "duruofu",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "chcp 65001 && nodemon --exec electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.byteflow",
    "win": {
      "icon": "./favicon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "nodemon": "^3.1.9",
    "electron-builder": "^25.1.8"
  }
}
